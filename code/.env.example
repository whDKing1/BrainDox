# LLM Configuration
# DeepSeek API Key
OPENAI_API_KEY=sk-xxx

# DeepSeek V3/V4 模型名
OPENAI_MODEL=deepseek-v4-pro

# DeepSeek API 地址
OPENAI_BASE_URL=https://api.deepseek.com

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical_decision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# FHIR Server
FHIR_SERVER_URL=http://localhost:8080/fhir

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# JWT
JWT_SECRET_KEY=braindox-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_PATIENT_EXPIRE_HOURS=168
JWT_DOCTOR_EXPIRE_MINUTES=240

# SMTP Email
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_USE_TLS=true

# PDF
PDF_STORAGE_PATH=./reports
